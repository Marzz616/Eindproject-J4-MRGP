APP_NAME="Voedselbank Maaskantje"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Amsterdam
APP_URL=http://voedselbanknieuw.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------
#  Database: hetzelfde schema als de vorige versie.
#  Maak in TablePlus/phpMyAdmin een lege database "voedselbank" aan
#  en vul die met:  php artisan migrate --seed
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voedselbank
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------
#  Sessie. De cookie heet VBSESSID en is HttpOnly + SameSite=Strict,
#  zodat JavaScript hem niet kan lezen en een andere website hem niet
#  kan meesturen (bescherming tegen XSS-diefstal en CSRF).
#  Na 60 minuten niets doen ben je uitgelogd.
# ---------------------------------------------------------------
SESSION_DRIVER=file
SESSION_COOKIE=VBSESSID
SESSION_LIFETIME=60
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
